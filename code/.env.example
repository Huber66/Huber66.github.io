# CyberHome 后端环境变量 —— 复制为 .env 或 backend/.env 后填入真实 Key。
# .env / backend/.env 已在 .gitignore 忽略，切勿提交。
#
# 如何生效：本文件由启动入口 `python3 -m cyberhome` 自动加载（见 __main__.py）。
#   一键启动：
#     python3 server.py
#   或在 backend/ 下单独启动：
#     uv run --with-requirements requirements.txt python3 -m cyberhome
#   注意：测试与 dev_smoke 不加载本文件（保「不联网」红线），仅真实起服务时读。

# ============ LLM Provider（F04）· 双模型切换 ============
# 两个 key 都可填。切换由 CYBERHOME_LLM_PROVIDER 决定：
#   · 显式设 deepseek / mimo / stub → 强制用该家（即便另一家也有 key）。
#   · 留空（注释掉）→ 自动降级链：有 DEEPSEEK_API_KEY 用 deepseek；否则有 MIMO_API_KEY 用 mimo；
#                    都没有 → StubChatModel（确定性模板，非真实涌现）。
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
MIMO_API_KEY=sk-your-mimo-key-here

# 切换开关：改这一行即切模型（缺省注释=按上面 key 自动选）。
# CYBERHOME_LLM_PROVIDER=deepseek
# CYBERHOME_LLM_PROVIDER=mimo

# 可选：覆盖模型名 / base_url（默认见下）。若你的账号实际模型名与默认不同，务必覆盖。
#   deepseek 默认 = deepseek-v4-flash @ https://api.deepseek.com
#   mimo     默认 = mimo-v2.5-pro     @ https://api.xiaomimimo.com/v1（小米官方开放平台）
# CYBERHOME_LLM_MODEL=
# CYBERHOME_LLM_BASE_URL=
#
# OpenAI-compatible 网关示例（如 newapi）：填真实 key 到本地 .env，不要提交。
# CYBERHOME_LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=sk-your-newapi-key
# CYBERHOME_LLM_BASE_URL=https://ioll.pp.ua

# 可选：调用护栏（默认 timeout=30s、max_retries=1；max_tokens / temperature 缺省不传）。
# CYBERHOME_LLM_TIMEOUT=30
# CYBERHOME_LLM_MAX_RETRIES=1
# CYBERHOME_LLM_MAX_TOKENS=
# CYBERHOME_LLM_TEMPERATURE=

# ============ 监听地址（对齐前端 127.0.0.1:8000）============
# CYBERHOME_HOST=127.0.0.1
# CYBERHOME_PORT=8000

# ============ 持久化（F03）============
# 开 SQLite 持久化（世界跨重启保留）。demo 建议开；缺省关，走内存（重启回 seed）。
# CYBERHOME_PERSIST=1
# CYBERHOME_DB_PATH=./data/cyberhome.db

# ============ 长记忆后端（F13 / F09）============
# 记忆后端：mem0（真向量库，需装 mem0ai+chromadb 且下方 OPENAI_API_KEY）/ memory（内存）/
#          空 = 自动探测（装了 mem0+chromadb 就试，否则内存）。失败自动回退，不阻塞主线。
# CYBERHOME_MEMORY_BACKEND=
# CYBERHOME_CHROMA_PATH=./data/chroma
# CYBERHOME_MEMORY_DB_PATH=./data/memory.db
# OPENAI_API_KEY=sk-your-openai-key-here
